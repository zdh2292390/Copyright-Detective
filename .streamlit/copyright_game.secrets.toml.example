# Merge these entries into .streamlit/secrets.toml or your Streamlit Cloud secrets.
# Never commit real values.

SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY = "your-server-only-service-role-key"
APP_URL = "https://YOUR_DEPLOYMENT_URL/"

# Shared by every participant. This value stays on the Streamlit server and is
# never placed in browser/session state or saved in user_settings.
COPYRIGHT_GAME_OPENAI_API_KEY = "your-shared-openai-api-key"

