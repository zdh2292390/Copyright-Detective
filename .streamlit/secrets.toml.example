# Copy to .streamlit/secrets.toml for local development.
# On Streamlit Cloud: App → Settings → Secrets

SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-public-key"
FERNET_KEY = "your-fernet-key"
# Required for Keep. Missing or invalid values reject the save; API keys are never newly stored as plaintext.
# Generate a valid key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_URL = "https://copyright-detective.streamlit.app/"

# --- Supabase Auth setup (required for GitHub login) ---
#
# 1) Enable GitHub provider
#    Supabase Dashboard → Authentication → Providers → GitHub → Enable
#    Fill in Client ID / Client Secret from your GitHub OAuth App (step 2).
#
# 2) Create a GitHub OAuth App
#    GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#    - Homepage URL: same as APP_URL (no trailing slash is also fine)
#    - Authorization callback URL:
#        https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#
# 3) URL Configuration (Supabase → Authentication → URL Configuration)
#    - Site URL: APP_URL (must match deployment URL exactly)
#    - Redirect URLs: MUST include a wildcard so OAuth can return with ?cd_cv=...
#        https://copyright-detective.streamlit.app/**
#      (Without the wildcard, sign-in fails because PKCE is passed in the callback URL.)
#
# 4) Database table for saved API keys
#    Run supabase/user_settings.sql in Supabase SQL Editor.
#
# 5) Local development
#    Set APP_URL = "http://localhost:8501/" and add the same two redirect URLs
#    for localhost in Supabase before testing locally.
#
# Generate FERNET_KEY locally:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
